{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humcapture.local/schemas/evidence-control/1.1.0/release-record.schema.json",
  "title": "HumCapture release record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_format_version", "release_id", "classification", "software_version", "created_utc", "created_by_windows_account", "repository", "source_inventory", "executed_artifacts", "technical_release_preconditions_met", "regulatory_use_permitted", "limitations"],
  "properties": {
    "record_format_version": { "const": "1.1.0" },
    "release_id": { "type": "string", "pattern": "^HC-(ENG|REL)-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$" },
    "classification": { "enum": ["ENGINEERING_SNAPSHOT", "CONTROLLED_RELEASE"] },
    "software_version": { "type": "string", "minLength": 1 },
    "created_utc": { "type": "string", "format": "date-time" },
    "created_by_windows_account": { "type": "string", "minLength": 1 },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["humcapture_path", "parent_commit_sha", "tracking_state", "worktree_state"],
      "properties": {
        "humcapture_path": { "const": "src/HumCapture" },
        "parent_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "tracking_state": { "enum": ["TRACKED", "UNTRACKED"] },
        "worktree_state": { "enum": ["CLEAN", "DIRTY"] }
      }
    },
    "source_inventory": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "sha256", "file_count", "exclusions"],
      "properties": {
        "algorithm": { "const": "sorted-relative-path-size-sha256-v1" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "file_count": { "type": "integer", "minimum": 1 },
        "exclusions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "executed_artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "path", "byte_length", "sha256"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "sbom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "spec_version", "path", "byte_length", "sha256", "generated_utc", "project_validation_passed", "official_validation_passed", "official_validator"],
      "properties": {
        "format": { "const": "CycloneDX" },
        "spec_version": { "const": "1.7" },
        "path": { "type": "string", "minLength": 1 },
        "byte_length": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "generated_utc": { "type": "string", "format": "date-time" },
        "project_validation_passed": { "const": true },
        "official_validation_passed": { "type": "boolean" },
        "official_validator": { "type": "string", "minLength": 1 }
      }
    },
    "technical_release_preconditions_met": { "type": "boolean" },
    "regulatory_use_permitted": { "const": false },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "required": ["classification"], "properties": { "classification": { "const": "ENGINEERING_SNAPSHOT" } } },
      "then": { "properties": { "regulatory_use_permitted": { "const": false } } }
    },
    {
      "if": { "required": ["classification"], "properties": { "classification": { "const": "CONTROLLED_RELEASE" } } },
      "then": {
        "required": ["sbom"],
        "properties": {
          "technical_release_preconditions_met": { "const": true },
          "regulatory_use_permitted": { "const": false },
          "repository": {
            "type": "object",
            "properties": {
              "tracking_state": { "const": "TRACKED" },
              "worktree_state": { "const": "CLEAN" }
            }
          },
          "sbom": {
            "type": "object",
            "properties": { "official_validation_passed": { "const": true } }
          }
        }
      }
    }
  ]
}
