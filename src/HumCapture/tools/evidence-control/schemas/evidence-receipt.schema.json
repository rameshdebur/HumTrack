{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humcapture.local/schemas/evidence-control/1.0.0/evidence-receipt.schema.json",
  "title": "HumCapture controlled evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_format_version", "evidence_id", "source_run_id", "test_case_id", "release_id", "release_record_sha256", "imported_utc", "imported_by_windows_account", "disposition", "review_state", "data_classification", "retention_class", "source_provenance", "artifacts", "artifact_set_sha256", "limitations"],
  "properties": {
    "record_format_version": { "const": "1.0.0" },
    "evidence_id": { "type": "string", "pattern": "^HC-EV-[a-f0-9]{24}$" },
    "source_run_id": { "type": "string", "minLength": 1 },
    "test_case_id": { "type": "string", "minLength": 1 },
    "release_id": { "type": "string", "minLength": 1 },
    "release_record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "imported_utc": { "type": "string", "format": "date-time" },
    "imported_by_windows_account": { "type": "string", "minLength": 1 },
    "disposition": { "enum": ["PASS", "FAIL", "CONDITIONAL", "INCONCLUSIVE", "ABORTED"] },
    "review_state": { "const": "DRAFT" },
    "data_classification": { "enum": ["SYNTHETIC_NON_SUBJECT", "SUBJECT_RESTRICTED", "REDACTED"] },
    "retention_class": { "const": "PROJECT_LIFETIME_PENDING_POLICY" },
    "source_provenance": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["relative_path", "byte_length", "sha256"],
        "properties": {
          "relative_path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "artifact_set_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
