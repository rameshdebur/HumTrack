{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humcapture.local/schemas/phase-0/1.0.0/common.schema.json",
  "title": "HumCapture Phase 0 common definitions",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "timestampDomain": {
      "type": "string",
      "enum": [
        "sensor_monotonic",
        "device_monotonic",
        "android_elapsed_realtime",
        "media_presentation",
        "host_qpc",
        "host_sample",
        "host_arrival",
        "utc",
        "synthesized",
        "unknown"
      ]
    },
    "timestampUnit": {
      "type": "string",
      "enum": ["ns", "us", "ms", "s", "ticks_100ns"]
    },
    "timestampProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_type", "channel_id", "timestamp_field", "domain", "source", "unit"],
      "properties": {
        "channel_type": {
          "type": "string",
          "enum": ["stream", "sensor", "system", "network"]
        },
        "channel_id": { "type": "string", "minLength": 1 },
        "timestamp_field": {
          "type": "string",
          "enum": ["source_timestamp", "presentation_timestamp", "host_arrival_timestamp", "timestamp"]
        },
        "domain": { "$ref": "#/$defs/timestampDomain" },
        "source": {
          "type": "string",
          "enum": ["sensor", "device", "host_sample", "host_arrival", "synthesized", "unknown"]
        },
        "unit": { "$ref": "#/$defs/timestampUnit" },
        "frequency_hz": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "mapping_method": { "type": ["string", "null"] },
        "uncertainty_ns": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9]+$" },
            { "type": "null" }
          ]
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "captureProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px", "fps", "codec"],
      "properties": {
        "width_px": { "type": "integer", "minimum": 1 },
        "height_px": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "codec": { "type": "string", "minLength": 1 },
        "pixel_format": { "type": ["string", "null"] },
        "bitrate_bps": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "media_type", "role", "byte_length", "sha256"],
      "properties": {
        "relative_path": { "$ref": "#/$defs/safeRelativePath" },
        "media_type": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["capability", "measurement", "log", "media", "summary", "other"]
        },
        "csv_dictionary": {
          "type": "string",
              "enum": ["frames", "sensors", "thermal-power-storage", "network", "compatibility", "capture-events"]
        },
        "byte_length": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "media_type": { "const": "text/csv" } }, "required": ["media_type"] },
          "then": {
            "properties": {
              "csv_dictionary": {
                "type": "string",
                "enum": ["frames", "sensors", "thermal-power-storage", "network", "compatibility", "capture-events"]
              }
            },
            "required": ["csv_dictionary"]
          }
        }
      ]
    }
  }
}
