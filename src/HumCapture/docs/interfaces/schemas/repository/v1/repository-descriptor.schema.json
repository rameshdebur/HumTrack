{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/repository/v1/repository-descriptor.schema.json",
  "title": "HumCapture repository descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_id",
    "interface_version",
    "namespace_version",
    "catalog_schema_version",
    "created_utc",
    "created_by_windows_account",
    "catalog_relative_path",
    "required_features"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "repository_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "interface_version": { "const": "1.3.0" },
    "namespace_version": { "const": "1.0.0" },
    "catalog_schema_version": { "const": "1.0.0" },
    "created_utc": { "type": "string", "format": "date-time" },
    "created_by_windows_account": { "$ref": "common.schema.json#/$defs/windows_account" },
    "catalog_relative_path": { "const": "catalog/humcapture.sqlite3" },
    "required_features": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["JOURNAL_HISTORY", "IMMUTABLE_RECORD_INDEX", "BOUNDED_RECONCILIATION"]
      },
      "allOf": [
        { "contains": { "const": "JOURNAL_HISTORY" } },
        { "contains": { "const": "IMMUTABLE_RECORD_INDEX" } },
        { "contains": { "const": "BOUNDED_RECONCILIATION" } }
      ]
    }
  }
}
