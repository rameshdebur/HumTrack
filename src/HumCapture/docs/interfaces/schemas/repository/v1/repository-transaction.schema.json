{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/repository/v1/repository-transaction.schema.json",
  "title": "HumCapture current repository transaction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transaction_id", "repository_id", "revision", "state",
    "subject_id", "session_id", "trial_id", "source_id", "capture_attempt_id",
    "collection_attempt_id", "package_id", "package_content_sha256",
    "artifact_set_sha256", "verification_record_id",
    "verification_record_content_sha256", "staging_relative_path",
    "destination_relative_path", "package_byte_length", "artifact_count",
    "commit_record_id", "commit_record_content_sha256", "quarantine_record_id",
    "last_reconciliation_id", "created_utc", "state_changed_utc"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "transaction_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "repository_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "state": { "$ref": "common.schema.json#/$defs/repository_state" },
    "subject_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "collection_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifact_set_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "verification_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "verification_record_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "staging_relative_path": { "$ref": "common.schema.json#/$defs/relative_path" },
    "destination_relative_path": { "$ref": "common.schema.json#/$defs/relative_path" },
    "package_byte_length": { "$ref": "common.schema.json#/$defs/u64" },
    "artifact_count": { "type": "integer", "minimum": 1 },
    "commit_record_id": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
    },
    "commit_record_content_sha256": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/sha256" }, { "type": "null" }]
    },
    "quarantine_record_id": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
    },
    "last_reconciliation_id": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/uuid" }, { "type": "null" }]
    },
    "created_utc": { "type": "string", "format": "date-time" },
    "state_changed_utc": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "COMMITTED" } }, "required": ["state"] },
      "then": {
        "properties": {
          "commit_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "commit_record_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "QUARANTINED" } }, "required": ["state"] },
      "then": { "properties": { "quarantine_record_id": { "$ref": "common.schema.json#/$defs/uuid" } } }
    },
    {
      "if": {
        "properties": { "commit_record_id": { "type": "string" } },
        "required": ["commit_record_id"]
      },
      "then": { "properties": { "commit_record_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" } } },
      "else": { "properties": { "commit_record_content_sha256": { "type": "null" } } }
    }
  ]
}
