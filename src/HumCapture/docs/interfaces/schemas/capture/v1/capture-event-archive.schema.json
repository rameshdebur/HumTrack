{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/capture/v1/capture-event-archive.schema.json",
  "title": "HumCapture capture event archive projection",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "package_id", "session_id", "trial_id", "source_id", "source_boot_id", "capture_attempt_id", "source_kind", "completeness", "events"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "package_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "source_boot_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "source_kind": { "$ref": "../../control/v1/common.schema.json#/$defs/sourceKind" },
    "completeness": { "enum": ["COMPLETE", "PARTIAL"] },
    "reason": { "$ref": "../../control/v1/common.schema.json#/$defs/reason" },
    "events": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["event_id", "event_sequence", "event_type", "event_source_time", "prior_state", "resulting_state", "resulting_source_revision"],
        "properties": {
          "event_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
          "event_sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "event_type": { "enum": ["STATE_TRANSITION", "FIRST_MASTER_SAMPLE", "READINESS_INVALIDATED", "DEVICE_LOST", "FINALIZATION_RESULT", "HEALTH_CHANGED", "COMMAND_RESULT"] },
          "event_source_time": { "$ref": "../../control/v1/common.schema.json#/$defs/monotonicInstant" },
          "prior_state": { "$ref": "../../control/v1/common.schema.json#/$defs/sourceState" },
          "resulting_state": { "$ref": "../../control/v1/common.schema.json#/$defs/sourceState" },
          "resulting_source_revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "reason": { "$ref": "../../control/v1/common.schema.json#/$defs/reason" }
        }
      }
    }
  },
  "allOf": [{ "if": { "properties": { "completeness": { "const": "PARTIAL" } } }, "then": { "properties": { "reason": {} }, "required": ["reason"] } }]
}
