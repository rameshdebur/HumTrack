{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/package-commit-receipt.schema.json",
  "title": "HumCapture package commit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "receipt_revision", "commit_id", "session_id",
    "trial_id", "source_id", "capture_attempt_id", "package_id",
    "package_content_sha256", "artifact_set_sha256", "repository_relative_path",
    "issued_by_coordinator_id", "issued_utc"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "receipt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "receipt_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "commit_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifact_set_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "repository_relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$", "maxLength": 1024 },
    "issued_by_coordinator_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "supersedes_receipt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "issued_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
