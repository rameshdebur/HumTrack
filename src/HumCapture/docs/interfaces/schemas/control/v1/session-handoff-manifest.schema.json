{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/session-handoff-manifest.schema.json",
  "title": "HumCapture session handoff manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "handoff_manifest_id",
    "handoff_manifest_revision",
    "session_id",
    "subject_id",
    "protocol_snapshot_id",
    "protocol_snapshot_content_sha256",
    "completion_record_id",
    "completion_record_revision",
    "repository_relative_session_path",
    "artifacts",
    "created_utc"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "handoff_manifest_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "handoff_manifest_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "supersedes_handoff_manifest_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "subject_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "protocol_snapshot_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "protocol_snapshot_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "completion_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "completion_record_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "repository_relative_session_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "byte_length", "sha256", "artifact_role"],
        "properties": {
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "artifact_role": { "enum": ["MASTER", "METADATA", "TIMING", "IMU", "QUALITY", "AUDIT", "MANIFEST"] }
        }
      }
    },
    "created_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
