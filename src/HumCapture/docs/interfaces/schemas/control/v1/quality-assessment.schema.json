{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/quality-assessment.schema.json",
  "title": "HumCapture immutable package quality assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "assessment_id", "assessment_revision", "session_id",
    "trial_id", "source_id", "capture_attempt_id", "package_id",
    "package_content_sha256", "outcome", "dimensions", "assessed_utc"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "assessment_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "assessment_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "supersedes_assessment_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "outcome": { "$ref": "common.schema.json#/$defs/qualityOutcome" },
    "dimensions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dimension", "outcome", "rule_version", "evidence_refs"],
        "properties": {
          "dimension": { "enum": ["IDENTITY", "INTEGRITY_DECODE", "PROFILE_CADENCE", "TIMING", "FINALIZATION", "CALIBRATION", "CAMERA_METADATA", "IMU", "CONTINUITY", "OPERATOR_VIEW", "DEVICE_HEALTH", "RECOVERY_PROVENANCE"] },
          "outcome": { "$ref": "common.schema.json#/$defs/qualityOutcome" },
          "rule_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "evidence_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuid" } },
          "reason": { "$ref": "common.schema.json#/$defs/reason" },
          "authorized_deviation_id": { "$ref": "common.schema.json#/$defs/uuid" }
        }
      }
    },
    "assessed_by_windows_account": { "$ref": "common.schema.json#/$defs/windowsAccount" },
    "assessed_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["PASS", "PASS_WITH_WARNINGS", "DEVIATION_REVIEW_REQUIRED", "FAIL_RETAKE_REQUIRED", "NOT_APPLICABLE"] } } },
      "then": { "properties": { "assessed_by_windows_account": {} }, "required": ["assessed_by_windows_account"] }
    }
  ]
}
