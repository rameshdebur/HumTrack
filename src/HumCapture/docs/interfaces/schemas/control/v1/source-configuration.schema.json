{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/source-configuration.schema.json",
  "title": "HumCapture source configuration binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "configuration_id", "configuration_revision",
    "configuration_content_sha256", "session_id", "trial_id", "source_id",
    "capture_attempt_id", "source_kind", "device_identity_id",
    "requested_profile_id", "maximum_duration_ns"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "configuration_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "configuration_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "configuration_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_kind": { "$ref": "common.schema.json#/$defs/sourceKind" },
    "device_identity_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "requested_profile_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "actual_profile_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "camera_metadata_profile_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "imu_required": { "type": "boolean" },
    "maximum_duration_ns": { "$ref": "common.schema.json#/$defs/durationNanoseconds" },
    "created_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
