{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/cleanup-result.schema.json",
  "title": "HumCapture truthful per-package cleanup result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cleanup_result_id", "cleanup_request_id", "device_id", "packages", "completed_utc"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "cleanup_result_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "cleanup_request_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["receipt_id", "source_id", "package_id", "package_content_sha256", "result", "remaining_artifact_relative_paths"],
        "properties": {
          "receipt_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
          "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "result": { "enum": ["DELETED", "PARTIAL_DELETE", "NOT_FOUND", "REJECTED_NOT_SAFE"] },
          "remaining_artifact_relative_paths": {
            "type": "array", "maxItems": 10000, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$", "maxLength": 1024 }
          },
          "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
        },
        "allOf": [
          { "if": { "properties": { "result": { "const": "DELETED" } } }, "then": { "properties": { "remaining_artifact_relative_paths": { "type": "array", "maxItems": 0 } } } },
          { "if": { "properties": { "result": { "const": "PARTIAL_DELETE" } } }, "then": { "properties": { "remaining_artifact_relative_paths": { "type": "array", "minItems": 1 }, "reason_code": {} }, "required": ["reason_code"] } },
          { "if": { "properties": { "result": { "enum": ["NOT_FOUND", "REJECTED_NOT_SAFE"] } } }, "then": { "properties": { "reason_code": {} }, "required": ["reason_code"] } }
        ]
      }
    },
    "completed_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
