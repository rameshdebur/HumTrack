{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/session-completion-record.schema.json",
  "title": "HumCapture session completion record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "completion_record_id",
    "completion_record_revision",
    "session_id",
    "subject_id",
    "protocol_snapshot_id",
    "protocol_snapshot_content_sha256",
    "satisfied_required_slots",
    "accepted_trial_ids",
    "committed_package_ids",
    "quality_review_complete",
    "unresolved_required_work",
    "finalized_by_windows_account",
    "finalized_utc",
    "handoff_manifest_id",
    "handoff_manifest_revision"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "completion_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "completion_record_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "supersedes_completion_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "subject_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "protocol_snapshot_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "protocol_snapshot_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "satisfied_required_slots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    },
    "accepted_trial_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    },
    "committed_package_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    },
    "quality_review_complete": { "const": true },
    "unresolved_required_work": { "const": false },
    "finalized_by_windows_account": { "$ref": "common.schema.json#/$defs/windowsAccount" },
    "finalized_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" },
    "handoff_manifest_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "handoff_manifest_revision": { "$ref": "common.schema.json#/$defs/positiveRevision" }
  }
}
