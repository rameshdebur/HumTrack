{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/receipt-status-query.schema.json",
  "title": "HumCapture receipt status query",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "query_id", "receipt_id", "receipt_revision", "device_id", "source_id", "package_id", "package_content_sha256", "queried_utc"],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "query_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "receipt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "receipt_revision": { "const": 1 },
    "device_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "queried_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  }
}
