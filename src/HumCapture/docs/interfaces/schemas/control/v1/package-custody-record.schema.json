{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/control/v1/package-custody-record.schema.json",
  "title": "HumCapture authoritative package custody record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "custody_record_id", "revision", "session_id", "trial_id",
    "source_id", "capture_attempt_id", "package_id", "package_content_sha256",
    "state", "authority", "collection_method", "recorded_utc"
  ],
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "custody_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "revision": { "$ref": "common.schema.json#/$defs/positiveRevision" },
    "session_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "trial_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "source_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "capture_attempt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "state": { "$ref": "common.schema.json#/$defs/custodyState" },
    "authority": { "enum": ["SOURCE", "COLLECTOR", "VERIFIER", "REPOSITORY"] },
    "collection_method": { "enum": ["NOT_STARTED", "HTTPS", "USB_MTP"] },
    "bytes_verified": { "$ref": "common.schema.json#/$defs/unsignedDecimal64" },
    "verification_record_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "commit_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "repository_relative_path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._ -]+(?:/[A-Za-z0-9._ -]+)*$", "maxLength": 1024 },
    "receipt_id": { "$ref": "common.schema.json#/$defs/uuid" },
    "reason": { "$ref": "common.schema.json#/$defs/reason" },
    "recorded_utc": { "$ref": "common.schema.json#/$defs/utcTimestamp" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "enum": ["VERIFIED", "COMMITTING", "COMMITTED", "RECEIPT_PENDING", "RECEIPT_ACKNOWLEDGED", "SAFE_TO_DELETE", "DELETED_FROM_SOURCE"] } } },
      "then": { "properties": { "verification_record_id": {} }, "required": ["verification_record_id"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["COMMITTED", "RECEIPT_PENDING", "RECEIPT_ACKNOWLEDGED", "SAFE_TO_DELETE", "DELETED_FROM_SOURCE"] } } },
      "then": { "properties": { "commit_id": {}, "repository_relative_path": {} }, "required": ["commit_id", "repository_relative_path"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["RECEIPT_ACKNOWLEDGED", "SAFE_TO_DELETE", "DELETED_FROM_SOURCE"] } } },
      "then": { "properties": { "receipt_id": {} }, "required": ["receipt_id"] }
    },
    {
      "if": { "properties": { "state": { "enum": ["COLLECTION_INTERRUPTED", "VERIFICATION_FAILED", "QUARANTINED", "COMMIT_RECOVERY_REQUIRED", "RECEIPT_STATUS_UNKNOWN"] } } },
      "then": { "properties": { "reason": {} }, "required": ["reason"] }
    }
  ]
}
