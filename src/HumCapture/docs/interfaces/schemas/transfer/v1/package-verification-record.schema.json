{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://humtrack.invalid/humcapture/transfer/v1/package-verification-record.schema.json",
  "title": "HumCapture package verification record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "verification_record_id", "revision", "package_id", "package_content_sha256", "artifact_set_sha256", "verified_by_windows_account", "verifier_name", "verifier_version", "verified_utc", "outcome", "checks", "artifact_results"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "verification_record_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "revision": { "$ref": "../../control/v1/common.schema.json#/$defs/positiveRevision" },
    "package_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
    "package_content_sha256": { "$ref": "../../control/v1/common.schema.json#/$defs/sha256" },
    "artifact_set_sha256": { "$ref": "../../control/v1/common.schema.json#/$defs/sha256" },
    "verified_by_windows_account": { "$ref": "../../control/v1/common.schema.json#/$defs/windowsAccount" },
    "verifier_name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "verifier_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "verified_utc": { "$ref": "../../control/v1/common.schema.json#/$defs/utcTimestamp" },
    "outcome": { "enum": ["VERIFIED", "FAILED", "QUARANTINED"] },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["check", "required", "disposition", "evidence_references"],
        "properties": {
          "check": { "enum": ["MANIFEST_SCHEMA", "PACKAGE_IDENTITY", "PATH_SAFETY", "REGULAR_FILES", "ARTIFACT_SET", "BYTE_LENGTH", "SHA256", "MASTER_STRUCTURE", "MASTER_FULL_DECODE", "TIMING_EVENTS", "METADATA_PROFILE", "FINALIZATION"] },
          "required": { "type": "boolean" },
          "disposition": { "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_ASSESSED"] },
          "evidence_references": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }
        }
      }
    },
    "artifact_results": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["artifact_id", "relative_path", "required", "expected_byte_length", "observed_byte_length", "expected_sha256", "observed_sha256", "disposition"],
        "properties": {
          "artifact_id": { "$ref": "../../control/v1/common.schema.json#/$defs/uuid" },
          "relative_path": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "required": { "type": "boolean" },
          "expected_byte_length": { "$ref": "../../control/v1/common.schema.json#/$defs/unsignedDecimal64" },
          "observed_byte_length": { "$ref": "../../control/v1/common.schema.json#/$defs/unsignedDecimal64" },
          "expected_sha256": { "$ref": "../../control/v1/common.schema.json#/$defs/sha256" },
          "observed_sha256": { "$ref": "../../control/v1/common.schema.json#/$defs/sha256" },
          "disposition": { "enum": ["PASS", "FAIL"] },
          "reason": { "type": "string", "minLength": 3, "maxLength": 2000 }
        }
      }
    }
  }
}
